{
  "name": "spec-ds",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:lib": "ng build @spec/ui",
    "test:lib": "ng test @spec/ui --watch=false",
    "pack:lib": "npm run build:lib && cd dist/spec/ui && npm pack --pack-destination ../..",
    "publish:lib": "npm run build:lib && cd dist/spec/ui && npm publish",
    "build:docs": "ng build spec-ds"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/animations": "~21.2.0",
    "@angular/cdk": "~21.2.0",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@primeuix/themes": "~2.0.3",
    "primeicons": "^8.0.2",
    "primeng": "21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  }
}